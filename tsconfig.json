{
  "compilerOptions": {

    "types": ["node"],
    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "core", "chain", "scripts", "pricing", "exhange", "inventory", "executor", "strategy"],
  "exclude": ["node_modules", "dist"]
}